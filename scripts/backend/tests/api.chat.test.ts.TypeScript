import request from 'supertest';
import app from '../src/app';
import { User } from '../src/models/User';
import { Chat } from '../src/models/Chat';

describe('Chat API Endpoints', () => {
  let token: string;
  let userId: string;

  beforeAll(async () => {
    // Create test user
    const user = await User.create({
      email: 'test@example.com',
      password: 'password123',
      name: 'Test User',
    });
    userId = user._id.toString();

    // Generate token
    token = user.generateToken();
  });

  afterAll(async () => {
    // Cleanup
    await User.deleteMany({});
    await Chat.deleteMany({});
  });

  describe('POST /api/chat/send', () => {
    it('should send message and get AI response', async () => {
      const response = await request(app)
        .post('/api/chat/send')
        .set('Authorization', `Bearer ${token}`)
        .send({
          message: 'Hello, how are you?',
          conversationId: 'test-conv-1',
        });

      expect(response.status).toBe(200);
      expect(response.body).toHaveProperty('reply');
      expect(response.body).toHaveProperty('agentsUsed');
      expect(response.body.agentsUsed).toBeInstanceOf(Array);
      expect(response.body.agentsUsed.length).toBeGreaterThan(0);
    });

    it('should fail without authentication', async () => {
      const response = await request(app)
        .post('/api/chat/send')
        .send({
          message: 'Hello',
          conversationId: 'test-conv-1',
        });

      expect(response.status).toBe(401);
      expect(response.body).toHaveProperty('error');
    });

    it('should fail with empty message', async () => {
      const response = await request(app)
        .post('/api/chat/send')
        .set('Authorization', `Bearer ${token}`)
        .send({
          message: '',
          conversationId: 'test-conv-1',
        });

      expect(response.status).toBe(400);
    });
  });

  describe('GET /api/chat/history/:conversationId', () => {
    it('should retrieve chat history', async () => {
      // Create conversation first
      await Chat.create({
        userId,
        conversationId: 'test-conv-1',
        messages: [
          { role: 'user', content: 'Hello' },
          { role: 'assistant', content: 'Hi there!' },
        ],
      });

      const response = await request(app)
        .get('/api/chat/history/test-conv-1')
        .set('Authorization', `Bearer ${token}`);

      expect(response.status).toBe(200);
      expect(response.body).toHaveProperty('messages');
      expect(response.body.messages.length).toBe(2);
    });
  });
});
